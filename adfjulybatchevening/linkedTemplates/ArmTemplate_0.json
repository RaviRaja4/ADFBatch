							"name": "derivedColumn1"
						},
						{
							"name": "input1"
						},
						{
							"name": "output1"
						}
					],
					"scriptLines": [
						"input(order: 0,",
						"     allowSchemaDrift: true) ~> input1",
						"input1 derive(AddDateTime = currentTimestamp()) ~> derivedColumn1",
						"derivedColumn1 output() ~> output1"
